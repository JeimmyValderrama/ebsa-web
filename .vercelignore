# Nada local a Vercel: el limite de subida es de 100 MB.
# Espejo de .gitignore + streamlit_original (que .gitignore solo cubre como
# "streamlit_origen/" y por eso se subio entero rompiendo el deploy).
streamlit_original/
# Igual que en .gitignore: solo entra el ejemplo simulado de retroalimentacion.
streamlit_origen/*
!streamlit_origen/datos
streamlit_origen/datos/*
!streamlit_origen/datos/07_gestion_caida
streamlit_origen/datos/07_gestion_caida/*
!streamlit_origen/datos/07_gestion_caida/retroalimentacion
streamlit_origen/datos/07_gestion_caida/retroalimentacion/*
!streamlit_origen/datos/07_gestion_caida/retroalimentacion/ejemplo_simulado
streamlit_origen/datos/07_gestion_caida/retroalimentacion/ejemplo_simulado/*

# Secrets
.env
.env.*
*.local

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
frontend/dist/
.pnpm-store/

# Datos locales
data/
*.csv
*.parquet
*.feather
*.db
*.db-journal
*.sqlite*
# Debe ir despues de *.csv: ultima regla que gana para ese archivo.
!streamlit_origen/datos/07_gestion_caida/retroalimentacion/ejemplo_simulado/EJEMPLO_SIMULADO_evaluacion_resumen.csv
carga_checkpoint.json
carga_checkpoint.json.tmp
carga_checkpoint.json.temp

# IDE/OS y estado de Vercel
.vscode/
.idea/
.DS_Store
Thumbs.db
.vercel/
.vercel
.vercel-env-check
