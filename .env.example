# Backend local / Vercel runtime
EBSA_ENV=development
# Producción: Azure SQL Database. Si se omite, se usa SQLite local para pruebas.
# URL completa alternativa:
# EBSA_DATABASE_URL=mssql+mssqlpython://USUARIO:CONTRASEÑA@SERVIDOR.database.windows.net:1433/ebsa?encrypt=yes&trustservercertificate=no
EBSA_DATABASE_URL=
AZURE_SQL_SERVER=servidor.database.windows.net
AZURE_SQL_DATABASE=ebsa
AZURE_SQL_USERNAME=usuario
AZURE_SQL_PASSWORD=
AZURE_SQL_PORT=1433

# CORS: en producción usa el dominio exacto del frontend
EBSA_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Firebase Admin SDK para verificar ID Tokens en FastAPI.
# Nunca guardes estas credenciales en Git.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Carpeta local que contiene los resultados del pipeline.
EBSA_DATA_DIR=C:\\Datos_Ebsa
