# Backend local / Vercel runtime
EBSA_ENV=development
# Producción: PostgreSQL. Desarrollo sin servidor: puede omitirse y se usa SQLite local.
# Usamos un nombre propio para no confundirlo con un DATABASE_URL MySQL gestionado.
EBSA_DATABASE_URL=postgresql+psycopg://ebsa:change-me@localhost:5432/ebsa

# CORS: en producción usa el dominio exacto del frontend
EBSA_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Firebase Admin SDK para verificar ID Tokens en FastAPI.
# Nunca guardes estas credenciales en Git.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Carpeta local que contiene los resultados del pipeline.
EBSA_DATA_DIR=C:\\Datos_Ebsa
