# Vacío en desarrollo si Vite y FastAPI usan dominios separados.
# En producción, Vercel puede servir frontend y API bajo el mismo dominio.
VITE_API_BASE_URL=

# Firebase Web App config. Estos valores web no son secretos, pero deben
# corresponder al proyecto Firebase correcto.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
